# Build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/

# Credentials — NEVER commit (loaded from D:\opencode\ or with_env.bat)
credentials/
# Credential / token JSON files (specific — don't blanket-ignore all JSON)
memory.json
ghost_credentials.json
g4f_locked_config.json
oauth_token.json
oauth_refresh.json
token.json
secrets.json
# Per-chat state JSON (state_manager output)
chat_*.json
state_*.json
# Sample reports ARE committed (they're test fixtures)
!sample_reports/*.json
!tests/sample_refs.txt
!package.json
!tests/generate_sample_reports.py

# Environment
.env
.venv/
venv/
env/

# State / data (per-chat JSON)
data/state/
data/logs/
*.log

# Local downloads
downloads/
/tmp/lit_downloads/
pdf_files/

# smoke_reports/ regenerated each CI run; sample_reports/ IS committed
smoke_reports/

# Database files (regenerated each run)
*.db

# Reference manager libraries (personal, large — never commit)
*.sdf

# Generated reports / spreadsheets (regenerated each run)
master_papers.xlsx
ULTIMATE_RESEARCH_SYNTHESIS.xlsx
ULTIMATE_RESEARCH_SYNTHESIS.docx
ULTIMATE_RESEARCH_SYNTHESIS_V10.xlsx

# Backup files
*.backup

# Brain report (regenerated each run)
brain_report.md

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Coverage
.coverage
htmlcov/
*.cover
.tox/

# Node (for v0.2 chapter writer)
node_modules/
package-lock.json
with_env.bat  
